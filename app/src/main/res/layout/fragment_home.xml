<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:windowSoftInputMode="adjustResize"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ekeyboard Settings"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/popupPositionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Label Popup Position"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/titleTextView"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/popupPositionValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-300"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/popupPositionLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/popupPositionSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="1400"
            android:progress="1200"
            app:layout_constraintTop_toBottomOf="@id/popupPositionValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/rangeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Range: -100 to -1500"
            android:textSize="12sp"
            android:textColor="#666666"
            app:layout_constraintTop_toBottomOf="@id/popupPositionSeekBar"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/instructionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Adjust the position of the key label popup that appears when typing in T13/T13C/Chinese modes. Lower values move the popup higher on the screen."
            android:textSize="14sp"
            android:textColor="#666666"
            app:layout_constraintTop_toBottomOf="@id/rangeTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/t13SettingsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T13 Keyboard Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/instructionTextView"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="32dp" />

        <CheckBox
            android:id="@+id/t13AutoSpaceCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add space after selecting word"
            android:textSize="16sp"
            android:checked="false"
            app:layout_constraintTop_toBottomOf="@id/t13SettingsLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/editText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Test your keyboard here..."
            app:layout_constraintTop_toBottomOf="@id/t13AutoSpaceCheckBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:inputType="text" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>

